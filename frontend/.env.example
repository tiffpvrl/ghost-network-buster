# Optional: when backend DEMO_API_KEY is set, paste the same value here.
# VITE_DEMO_API_KEY=my-secret-demo-key

# Production: your Cloud Run / API origin (omit in local dev; Vite proxies /api)
# VITE_API_BASE=https://your-api.run.app

# Set to false to hide the Employer nav item (default: shown)
# VITE_SHOW_EMPLOYER=false

# Optional landing-page line for expected audit duration (fallback when preview count is unknown)
# VITE_AUDIT_DURATION_HINT=~90 seconds for this sample

# Conservative seconds per listing for ETA on the landing page: max(60, previewCount * factor)
# VITE_AUDIT_SECONDS_PER_CALL=12

# Optional: use hosted legal pages instead of in-app /terms and /privacy
# VITE_TERMS_URL=https://example.com/terms
# VITE_PRIVACY_URL=https://example.com/privacy

# Backend: SHARE_MAX_AGE_HOURS caps how long read-only result/share links stay valid (410 when expired).

# Optional: show confetti when a non-demo audit completes with at least one usable listing (demo always shows if motion is allowed).
# VITE_CELEBRATE_COMPLETION=true