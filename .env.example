# Copy to .env and adjust. Never commit .env.

# --- Voice ---
# Use "mock" for free local dev. Switch to "pipecat" for real Twilio calls.
VOICE_PROVIDER=mock

# --- Twilio (required when VOICE_PROVIDER=pipecat) ---
# Sign up at twilio.com with personal email, upgrade trial to paid (card required, ~$1/mo for number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # E.164 format e.g. +12125551234

# --- Pipecat services (required when VOICE_PROVIDER=pipecat) ---
# Deepgram: free 10K min/month — deepgram.com
DEEPGRAM_API_KEY=
# Public URL for Twilio webhooks — run `ngrok http 8000` and paste the HTTPS URL here
PUBLIC_URL=

# --- Deepgram STT/TTS (Pipecat; tune for phone media streams) ---
# STT: LiveOptions — match Twilio 8 kHz upstream unless you know your transport differs.
# STT model id for streaming (not bare "nova-2"). Examples: nova-3-general, nova-2-general, nova-2-phonecall (8 kHz calls).
DEEPGRAM_STT_MODEL=nova-2-phonecall
DEEPGRAM_STT_LANGUAGE=en-US
DEEPGRAM_STT_SAMPLE_RATE=8000
DEEPGRAM_STT_UTTERANCE_END_MS=1000
DEEPGRAM_STT_SMART_FORMAT=true
DEEPGRAM_STT_INTERIM_RESULTS=true
# Endpointing ms (silence before segment); use 0 to disable Deepgram endpointing
DEEPGRAM_STT_ENDPOINTING_MS=800
# TTS: voice ID (see Deepgram Aura docs); output is resampled to Twilio 8 kHz µ-law in Pipecat
DEEPGRAM_TTS_VOICE=aura-2-helena-en
DEEPGRAM_TTS_SAMPLE_RATE=24000
# --- Cost guard (pipecat only) ---
# Audits with more providers than this are blocked unless override_cost_guard=true is passed.
# Keep at 5 while testing. Set to 0 to disable.
PIPECAT_COST_GUARD=5

# --- Concurrency (set these when VOICE_PROVIDER=pipecat to stay safe) ---
MAX_PARALLEL_CALLS=1          # 1 = easy to monitor in Twilio console while testing
LOOP_REVERIFY_VOICEMAIL=false # false = no re-dials, saves ~30% of call cost

# --- API ---
DEMO_API_KEY=my-secret-demo-key               # Optional: protects endpoints in public deployments
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Provider data ---
PROVIDERS_DATA_FILE=data/providers_test.json

# --- GCP / Vertex AI ---
# Required for: complaint letter LLM draft + Pipecat voice LLM + ADK agents
# Auth locally: run `gcloud auth application-default login`
# On Cloud Run: service account needs roles/aiplatform.user
GOOGLE_CLOUD_PROJECT=agentic-ai-capstone-project
VERTEX_LOCATION=us-central1
# Tell ADK's LlmAgent to route through Vertex AI (not the public Gemini API key path)
GOOGLE_GENAI_USE_VERTEXAI=true

# Optional — only needed for GCS audit/memory persistence on Cloud Run
GCS_AUDITS_BUCKET=
GCS_MEMORY_BUCKET=
