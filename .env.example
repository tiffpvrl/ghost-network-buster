# Copy to .env and adjust. Never commit .env.

# --- Voice ---
# Deployed default is "mock": MockVoiceProvider fabricates outcomes server-side
# (no Twilio, no calls placed) at a settings-driven pace, so the deployed URL is
# safe to share publicly. Switch to "pipecat" only on a local machine that has
# Twilio credentials configured below.
VOICE_PROVIDER=mock
# MockVoiceProvider per-call latency in seconds (lower bound, upper bound).
# 6–9s with MAX_PARALLEL_CALLS=1 produces a ~60–100s simulated audit, matching
# the patient-facing UI copy "~90 seconds for a typical sample". Lower for tests.
MOCK_VOICE_DELAY_MIN_S=6
MOCK_VOICE_DELAY_MAX_S=9
# Probability of a non-ghost ("real") outcome when the fixture row does not pin
# mock_outcome. 0.35 mirrors the employer-side simulator's GHOST_SHARE.
MOCK_VOICE_REAL_SHARE=0.35

# --- Twilio (required when VOICE_PROVIDER=pipecat) ---
# Sign up at twilio.com with personal email, upgrade trial to paid (card required, ~$1/mo for number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=          # E.164 format e.g. +12125551234

# --- Pipecat services (required when VOICE_PROVIDER=pipecat) ---
# Deepgram: free 10K min/month — deepgram.com
DEEPGRAM_API_KEY=
# Public URL for Twilio webhooks — run `ngrok http 8000` and paste the HTTPS URL here
PUBLIC_URL=

# --- Deepgram STT/TTS (Pipecat; tune for phone media streams) ---
# STT: LiveOptions — match Twilio 8 kHz upstream unless you know your transport differs.
# MUST match PipelineTask audio_in_sample_rate (defaults from DEEPGRAM_STT_SAMPLE_RATE=8000).
# STT model id for streaming (not bare "nova-2"). Examples: nova-3-general, nova-2-general, nova-2-phonecall (8 kHz calls).
DEEPGRAM_STT_MODEL=nova-2-phonecall
DEEPGRAM_STT_LANGUAGE=en-US
DEEPGRAM_STT_SAMPLE_RATE=8000
DEEPGRAM_STT_UTTERANCE_END_MS=1200
DEEPGRAM_STT_SMART_FORMAT=true
DEEPGRAM_STT_INTERIM_RESULTS=true
# Endpointing ms (silence before segment); use 0 to disable Deepgram endpointing
DEEPGRAM_STT_ENDPOINTING_MS=550
# TTS: voice ID (see Deepgram Aura docs); output is resampled to Twilio 8 kHz µ-law in Pipecat
DEEPGRAM_TTS_VOICE=aura-2-helena-en
DEEPGRAM_TTS_SAMPLE_RATE=24000
# TTS chunking: sentence = smoother playback on phone audio; token = lower latency between chunks
DEEPGRAM_TTS_TEXT_AGGREGATION=sentence

# If Deepgram omits a final on very short utterances, promote last interim after VAD stop (ms).
VOICE_STT_INTERIM_COMMIT_ENABLED=true
VOICE_STT_INTERIM_COMMIT_DELAY_MS=750
VOICE_STT_INTERIM_COMMIT_MIN_CHARS=2
# Dev only: print Deepgram interim/final transcripts to server logs (may include caller speech / PHI)
VOICE_STT_TRACE_ENABLED=false
# VAD segmentation (Twilio phone audio): higher stop = wait longer before "user stopped" (less mid-sentence cut)
VOICE_VAD_STOP_SECS=0.85
VOICE_VAD_START_SECS=0.2

# --- Cost guard (pipecat only) ---
# Audits with more providers than this are blocked unless override_cost_guard=true is passed.
# Keep at 5 while testing. Set to 0 to disable.
PIPECAT_COST_GUARD=5

# --- Concurrency (set these when VOICE_PROVIDER=pipecat to stay safe) ---
MAX_PARALLEL_CALLS=1          # 1 = easy to monitor in Twilio console while testing
LOOP_REVERIFY_VOICEMAIL=false # false = no re-dials, saves ~30% of call cost

# --- API ---
DEMO_API_KEY=my-secret-demo-key               # Optional: protects endpoints in public deployments
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ghost rate >= this value marks summary.high_ghost_rate (UI high-severity banners)
HIGH_GHOST_RATE_THRESHOLD=0.7
# If > 0, GET summary and downloads return 410 when audit is older than this many hours (started_at). 0 = off.
SHARE_MAX_AGE_HOURS=0

# --- Provider data ---
# Synthetic NY-themed fixture used by the deployed mock pipeline. No real phone
# numbers; phone fields are masked again by MockVoiceProvider before reaching
# the UI as defense-in-depth.
PROVIDERS_DATA_FILE=data/providers_sim.json
# Local override — uncomment to actually dial via Twilio (requires creds above):
# VOICE_PROVIDER=pipecat
# PROVIDERS_DATA_FILE=data/providers_test.json

# --- GCP / Vertex AI ---
# Required for: complaint letter LLM draft + Pipecat voice LLM + ADK agents
# Auth locally: run `gcloud auth application-default login`
# On Cloud Run: service account needs roles/aiplatform.user
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
# Gemini model id for live Pipecat calls (streaming). Must be enabled for VERTEX_LOCATION in your project.
VERTEX_PIPECAT_LLM_MODEL=gemini-2.5-flash
# Tell ADK's LlmAgent to route through Vertex AI (not the public Gemini API key path)
GOOGLE_GENAI_USE_VERTEXAI=true

# --- ADK orchestration ---
# true: POST /api/start-audit uses the ADK SequentialAgent (directory → voice → classify → RAG → synth).
# false: legacy asyncio pipeline (voice only; RAG bullets in complaint doc still use complaint_agent unless ADK ran).
USE_ADK_AUDIT=false
# true + VOICE_PROVIDER=pipecat: re-run ac_classify_transcript in the ADK graph (extra Vertex calls).
ADK_RECLASSIFY_AFTER_PIPECAT=false

# Optional — only needed for GCS audit/memory persistence on Cloud Run
GCS_AUDITS_BUCKET=
GCS_MEMORY_BUCKET=
