# Copy to .env and adjust. Never commit .env.

# --- Voice ---
VOICE_PROVIDER=mock
RETELL_API_KEY=
RETELL_AGENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- API ---
DEMO_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Concurrency / loop refinement ---
MAX_PARALLEL_CALLS=5
LOOP_REVERIFY_VOICEMAIL=true
LOOP_GHOST_RATE_THRESHOLD=0.9

# --- GCP (Cloud Run) ---
GOOGLE_CLOUD_PROJECT=
GCS_AUDITS_BUCKET=
GCS_AUDITS_PREFIX=audits/
GCS_MEMORY_BUCKET=
GCS_MEMORY_PREFIX=npi_memory/

# Local JSON fallback (relative to repo root unless absolute). Ephemeral on Cloud Run unless you mount disk.
AUDIT_LOCAL_DIR=data/audits
MEMORY_LOCAL_DIR=data/memory_npi

# Provider rows for audits (JSON array or {"providers":[...]})
# PROVIDERS_DATA_FILE=data/providers_aetna_nyc_joined.json

# NY Open Legislation API (https://legislation.nysenate.gov/) — for ingesting ISC §3217-A / §4324.
# Never commit real keys. Rotate any key that was pasted into chat or logs.
# LEGISLATION_NY_SENATE_API_KEY=

# --- Vertex (when you wire Gemini / Vector Search) ---
# VERTEX_LOCATION=us-central1
